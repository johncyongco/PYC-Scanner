    {
      "name": "Validate scan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const code = $('Scan webhook').first().json.body?.code;\nconst reply = (status, fields = {}) => [{ json: { status, ...fields } }];\nif (typeof code !== 'string' || !/^UNF-[A-F0-9]{16}$/.test(code)) {\n  return reply('not_found');\n}\nconst matches = $input.all().map(({ json }) => json)\n  .filter(row => String(row['Ticket Code'] ?? '').trim().toUpperCase() === code);\nif (!matches.length) return reply('not_found');\nif (matches.length > 1) return reply('duplicate_code');\nconst row = matches[0];\nconst name = [row['First Name'], row['Last Name']].map(value => String(value ?? '').trim())\n  .filter(Boolean).join(' ');\nif (String(row['Check-in Status'] ?? '').trim().toLowerCase() === 'present') {\n  return reply('already_present', { name, checkedInAt: row['Checked In At'] });\n}\nif (String(row['Payment Status'] ?? '').trim().toLowerCase() !== 'paid') {\n  return reply('unpaid');\n}\nconst rowNumber = Number(row.row_number);\nif (!Number.isInteger(rowNumber) || rowNumber < 2) throw Error('Missing response row number');\nreturn reply('present', { name, rowNumber, checkedInAt: new Date().toISOString() });"
      },
      "id": "ae7b8b26-ae59-4810-931f-8fbb5a2c77c0"
    },
    {
      "name": "First valid scan",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d9c12ef8-a77a-4697-a8ba-dfb76873ab98",
              "leftValue": "={{ $json.status }}",
              "rightValue": "present",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d91b7b1f-75f3-487d-843b-6d5c3853a13e"
    },
